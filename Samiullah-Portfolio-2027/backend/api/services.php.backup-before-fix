
<?php

header("Content-Type: application/json; charset=UTF-8");
$allowedOrigins = ["http://localhost:5173", "http://localhost:5174"];
$origin = $_SERVER["HTTP_ORIGIN"] ?? "";

if (in_array($origin, $allowedOrigins, true)) {
    header("Access-Control-Allow-Origin: " . $origin);
    header("Vary: Origin");
}
header("Access-Control-Allow-Credentials: true");
header("Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS");
header("Access-Control-Allow-Headers: Content-Type");

if ($_SERVER["REQUEST_METHOD"] === "OPTIONS") {
    http_response_code(204);
    exit;
}

session_start();

if ($_SERVER["REQUEST_METHOD"] !== "GET" && !isset($_SESSION["admin_id"])) {
    http_response_code(401);
    echo json_encode([
        "success" => false,
        "message" => "Unauthorized. Please login first."
    ]);
    exit;
}

require_once __DIR__ . "/../config/database.php";

function sendResponse($success, $message, $data = null, $status = 200) {
    http_response_code($status);

    echo json_encode([
        "success" => $success,
        "message" => $message,
        "data" => $data
    ], JSON_UNESCAPED_UNICODE);

    exit;
}

$method = $_SERVER["REQUEST_METHOD"];
$input = json_decode(file_get_contents("php://input"), true);

if (!is_array($input)) {
    $input = [];
}

$allowedCategories = [
    "Website & UI/UX Design",
    "Web Development",
    "Networking & IT",
    "Database & Hosting"
];

try {

    // GET SERVICES
    if ($method === "GET") {
        $stmt = $pdo->query(
            "SELECT * FROM services ORDER BY id DESC"
        );

        sendResponse(
            true,
            "Services loaded successfully.",
            $stmt->fetchAll(PDO::FETCH_ASSOC)
        );
    }

    // ADD SERVICE
    if ($method === "POST") {

        $title = trim($input["title"] ?? "");
        $description = trim($input["description"] ?? "");
        $category = trim($input["category"] ?? "");
        $icon = trim($input["icon"] ?? "Briefcase");
        $isActive = isset($input["is_active"])
            ? (int)$input["is_active"]
            : 1;

        if ($title === "" || $description === "") {
            sendResponse(false, "Title and description are required.", null, 422);
        }

        if (!in_array($category, $allowedCategories, true)) {
            sendResponse(false, "Invalid service category.", null, 422);
        }

        if (!in_array($isActive, [0, 1], true)) {
            sendResponse(false, "Invalid active value.", null, 422);
        }

        $stmt = $pdo->prepare(
            "INSERT INTO services
            (title, description, category, icon, is_active)
            VALUES (?, ?, ?, ?, ?)"
        );

        $stmt->execute([
            $title,
            $description,
            $category,
            $icon,
            $isActive
        ]);

        $id = (int)$pdo->lastInsertId();

        $get = $pdo->prepare(
            "SELECT * FROM services WHERE id = ?"
        );

        $get->execute([$id]);

        sendResponse(
            true,
            "Service added successfully.",
            $get->fetch(PDO::FETCH_ASSOC),
            201
        );
    }

    // UPDATE SERVICE
    if ($method === "PUT") {

        $id = (int)($input["id"] ?? 0);
        $title = trim($input["title"] ?? "");
        $description = trim($input["description"] ?? "");
        $category = trim($input["category"] ?? "");
        $icon = trim($input["icon"] ?? "Briefcase");
        $isActive = isset($input["is_active"])
            ? (int)$input["is_active"]
            : 1;

        if ($id <= 0 || $title === "" || $description === "") {
            sendResponse(false, "ID, title and description are required.", null, 422);
        }

        if (!in_array($category, $allowedCategories, true)) {
            sendResponse(false, "Invalid service category.", null, 422);
        }

        if (!in_array($isActive, [0, 1], true)) {
            sendResponse(false, "Invalid active value.", null, 422);
        }

        $check = $pdo->prepare(
            "SELECT id FROM services WHERE id = ?"
        );

        $check->execute([$id]);

        if (!$check->fetch()) {
            sendResponse(false, "Service not found.", null, 404);
        }

        $stmt = $pdo->prepare(
            "UPDATE services
            SET title = ?, description = ?, category = ?, icon = ?, is_active = ?
            WHERE id = ?"
        );

        $stmt->execute([
            $title,
            $description,
            $category,
            $icon,
            $isActive,
            $id
        ]);

        sendResponse(true, "Service updated successfully.");
    }

    // DELETE SERVICE
    if ($method === "DELETE") {

        $id = (int)($input["id"] ?? 0);

        if ($id <= 0) {
            sendResponse(false, "Valid service ID is required.", null, 422);
        }

        $stmt = $pdo->prepare(
            "DELETE FROM services WHERE id = ?"
        );

        $stmt->execute([$id]);

        if ($stmt->rowCount() === 0) {
            sendResponse(false, "Service not found.", null, 404);
        }

        sendResponse(true, "Service deleted successfully.");
    }

    sendResponse(false, "Method not allowed.", null, 405);

} catch (PDOException $e) {

    error_log($e->getMessage());

    sendResponse(
        false,
        "Database operation failed. Check PHP error log.",
        null,
        500
    );
}



