<?php

header("Content-Type: application/json; charset=UTF-8");
header("Access-Control-Allow-Origin: http://localhost:5174");
header("Access-Control-Allow-Credentials: true");
header("Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS");
header("Access-Control-Allow-Headers: Content-Type");

if ($_SERVER["REQUEST_METHOD"] === "OPTIONS") {
    http_response_code(204);
    exit;
}

session_start();

require_once __DIR__ . "/../config/database.php";

function pageResponse($success, $message, $data = null, $status = 200) {
    http_response_code($status);

    echo json_encode([
        "success" => $success,
        "message" => $message,
        "data" => $data
    ], JSON_UNESCAPED_UNICODE);

    exit;
}

$method = $_SERVER["REQUEST_METHOD"];
$input = json_decode(file_get_contents("php://input"), true);

if (!is_array($input)) {
    $input = [];
}

$isAdmin = isset($_SESSION["admin_id"]);

try {

    // GET PAGES
    // Public visitors see active pages only.
    // Logged-in admin can see all pages.
    if ($method === "GET") {

        $slug = trim($_GET["slug"] ?? "");

        if ($slug !== "") {
            $stmt = $pdo->prepare(
                "SELECT * FROM pages
                 WHERE page_slug = ?
                 " . (!$isAdmin ? "AND is_active = 1" : "")
            );

            $stmt->execute([$slug]);
            $page = $stmt->fetch(PDO::FETCH_ASSOC);

            if (!$page) {
                pageResponse(false, "Page not found.", null, 404);
            }

            pageResponse(true, "Page loaded successfully.", $page);
        }

        $sql = "SELECT * FROM pages";

        if (!$isAdmin) {
            $sql .= " WHERE is_active = 1";
        }

        $sql .= " ORDER BY id ASC";

        $stmt = $pdo->query($sql);

        pageResponse(
            true,
            "Pages loaded successfully.",
            $stmt->fetchAll(PDO::FETCH_ASSOC)
        );
    }

    // All remaining operations require admin login.
    if (!$isAdmin) {
        pageResponse(
            false,
            "Unauthorized. Please login first.",
            null,
            401
        );
    }

    // ADD PAGE
    if ($method === "POST") {

        $slug = trim($input["page_slug"] ?? "");
        $title = trim($input["page_title"] ?? "");
        $content = $input["page_content"] ?? "";
        $isActive = isset($input["is_active"])
            ? (int)$input["is_active"]
            : 1;

        if (
            $slug === "" ||
            !preg_match('/^[a-z0-9-]+$/', $slug) ||
            $title === ""
        ) {
            pageResponse(
                false,
                "Valid page slug and title are required.",
                null,
                422
            );
        }

        if (!is_string($content)) {
            pageResponse(false, "Page content must be text.", null, 422);
        }

        if (!in_array($isActive, [0, 1], true)) {
            pageResponse(false, "Invalid active value.", null, 422);
        }

        $stmt = $pdo->prepare(
            "INSERT INTO pages
            (page_slug, page_title, page_content, is_active)
            VALUES (?, ?, ?, ?)"
        );

        $stmt->execute([$slug, $title, $content, $isActive]);

        pageResponse(
            true,
            "Page added successfully.",
            ["id" => (int)$pdo->lastInsertId()],
            201
        );
    }

    // UPDATE PAGE
    if ($method === "PUT") {

        $id = (int)($input["id"] ?? 0);
        $title = trim($input["page_title"] ?? "");
        $content = $input["page_content"] ?? "";
        $isActive = isset($input["is_active"])
            ? (int)$input["is_active"]
            : 1;

        if ($id <= 0 || $title === "") {
            pageResponse(
                false,
                "Page ID and title are required.",
                null,
                422
            );
        }

        if (!is_string($content)) {
            pageResponse(false, "Page content must be text.", null, 422);
        }

        if (!in_array($isActive, [0, 1], true)) {
            pageResponse(false, "Invalid active value.", null, 422);
        }

        $stmt = $pdo->prepare(
            "UPDATE pages
             SET page_title = ?,
                 page_content = ?,
                 is_active = ?
             WHERE id = ?"
        );

        $stmt->execute([$title, $content, $isActive, $id]);

        if ($stmt->rowCount() === 0) {
            $check = $pdo->prepare("SELECT id FROM pages WHERE id = ?");
            $check->execute([$id]);

            if (!$check->fetch()) {
                pageResponse(false, "Page not found.", null, 404);
            }
        }

        pageResponse(true, "Page updated successfully.");
    }

    // DELETE PAGE
    if ($method === "DELETE") {

        $id = (int)($input["id"] ?? 0);

        if ($id <= 0) {
            pageResponse(false, "Valid page ID is required.", null, 422);
        }

        $stmt = $pdo->prepare("DELETE FROM pages WHERE id = ?");
        $stmt->execute([$id]);

        if ($stmt->rowCount() === 0) {
            pageResponse(false, "Page not found.", null, 404);
        }

        pageResponse(true, "Page deleted successfully.");
    }

    pageResponse(false, "Method not allowed.", null, 405);

} catch (PDOException $e) {

    error_log("Pages API Database Error: " . $e->getMessage());

    if ($e->getCode() === "23000") {
        pageResponse(false, "This page slug already exists.", null, 409);
    }

    pageResponse(false, "Database operation failed.", null, 500);

} catch (Throwable $e) {

    error_log("Pages API Error: " . $e->getMessage());

    pageResponse(false, "An unexpected server error occurred.", null, 500);
}
