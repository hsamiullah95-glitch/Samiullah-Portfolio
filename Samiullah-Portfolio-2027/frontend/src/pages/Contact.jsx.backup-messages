
import { useState } from 'react';
import {
  Mail,
  Phone,
  MapPin,
  Clock,
  Send,
  ArrowUpRight,
  MessageCircle,
  Globe,
  CheckCircle2,
  Sparkles,
} from 'lucide-react';

import './Contact.css';

export default function Contact() {
  const [form, setForm] = useState({
    name: '',
    email: '',
    subject: '',
    message: '',
  });

  const [sent, setSent] = useState(false);

  const handleChange = (e) => {
    setForm({
      ...form,
      [e.target.name]: e.target.value,
    });
  };

  const handleSubmit = (e) => {
    e.preventDefault();

    const subject = encodeURIComponent(form.subject);
    const body = encodeURIComponent(
      `Name: ${form.name}\nEmail: ${form.email}\n\nMessage:\n${form.message}`
    );

    window.location.href =
      `mailto:hsamiullah95@gmail.com?subject=${subject}&body=${body}`;

    setSent(true);
  };

  return (
    <main className="contact-page">

      {/* HERO SECTION */}
      <section className="contact-hero">

        <div className="hero-bg-circle circle-one"></div>
        <div className="hero-bg-circle circle-two"></div>
        <div className="hero-bg-circle circle-three"></div>

        <div className="contact-hero-inner">

          {/* LEFT CONTENT */}
          <div className="contact-hero-content">

            <span className="contact-label">
              <span className="label-dot"></span>
              <Sparkles size={15} />
              GET IN TOUCH
            </span>

            <h1>
              Let's Work
              <span>Together.</span>
            </h1>

            <p>
              Have a project, an idea, or a question?
              I would love to hear from you. Let's connect
              and create something amazing together.
            </p>

            <div className="hero-buttons">
              <a href="#contact-form" className="hero-primary-btn">
                Send a Message
                <ArrowUpRight size={19} />
              </a>

              <a href="mailto:hsamiullah95@gmail.com"
                 className="hero-secondary-btn">
                <Mail size={18} />
                Email Me
              </a>
            </div>

            <div className="hero-mini-info">
              <span><span className="online-dot"></span> Available for Projects</span>
              <span>Professional Communication</span>
            </div>

          </div>

          {/* RIGHT CONTACT DETAILS */}
          <div className="contact-hero-right">

            <div className="hero-contact-heading">
              <span>LET'S CONNECT</span>
              <h2>Contact Information</h2>
              <p>Reach me through these channels.</p>
            </div>

            <a
              href="mailto:hsamiullah95@gmail.com"
              className="hero-contact-card hero-email"
            >
              <div className="hero-contact-icon">
                <Mail size={25} />
              </div>

              <div className="hero-contact-text">
                <span>EMAIL ADDRESS</span>
                <h3>hsamiullah95@gmail.com</h3>
              </div>

              <ArrowUpRight className="hero-contact-arrow" size={22} />
            </a>

            <a
              href="tel:0791550796"
              className="hero-contact-card hero-phone"
            >
              <div className="hero-contact-icon">
                <Phone size={25} />
              </div>

              <div className="hero-contact-text">
                <span>PHONE NUMBER</span>
                <h3>0791550796</h3>
              </div>

              <ArrowUpRight className="hero-contact-arrow" size={22} />
            </a>

            <div className="hero-contact-note">
              <div className="note-icon">
                <MessageCircle size={20} />
              </div>
              <div>
                <h4>Have a question?</h4>
                <p>Feel free to contact me anytime.</p>
              </div>
            </div>

          </div>
        </div>

        <div className="hero-bottom-line">
          <span>CREATIVE IDEAS START HERE</span>
          <span>LET'S BUILD SOMETHING GREAT</span>
        </div>

      </section>

      {/* CONTACT INFORMATION + FORM */}
      <section className="contact-main">

        <div className="contact-heading">
          <span className="section-tag">CONTACT ME</span>
          <h2>Let's Start a <span>Conversation</span></h2>
          <p>
            I am always interested in hearing about new ideas,
            creative projects and opportunities.
          </p>
        </div>

        <div className="contact-grid">

          {/* LEFT INFORMATION */}
          <div className="contact-info-column">

            <div className="contact-info-card email-info">
              <div className="info-icon">
                <Mail size={25} />
              </div>

              <div className="info-content">
                <span>Email Address</span>
                <h3>Send me an email</h3>
                <a href="mailto:hsamiullah95@gmail.com">
                  hsamiullah95@gmail.com
                </a>
              </div>

              <ArrowUpRight className="info-arrow" size={22} />
            </div>

            <div className="contact-info-card phone-info">
              <div className="info-icon">
                <Phone size={25} />
              </div>

              <div className="info-content">
                <span>Phone Number</span>
                <h3>Call me directly</h3>
                <a href="tel:0791550796">
                  0791550796
                </a>
              </div>

              <ArrowUpRight className="info-arrow" size={22} />
            </div>

            <div className="contact-info-card location-info">
              <div className="info-icon">
                <MapPin size={25} />
