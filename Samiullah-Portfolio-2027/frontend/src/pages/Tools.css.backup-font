
.tools-page {
  --ot-bg: #0b1020;
  --ot-surface: #111a2d;
  --ot-panel: #121d32;
  --ot-panel-2: #17243b;
  --ot-border: #25334d;
  --ot-text: #edf3ff;
  --ot-muted: #8d9bb5;
  --ot-accent: #7895ff;
  --ot-accent-2: #9b83ff;
  --ot-green: #49d7a0;
  --ot-red: #ff737d;
  min-height: 100vh;
  padding: 34px 5%;
  background:
    radial-gradient(ellipse at 10% 0%, #1a2b50 0, transparent 35%),
    radial-gradient(ellipse at 95% 35%, #24204c 0, transparent 28%),
    var(--ot-bg);
  color: var(--ot-text);
  font-family: Inter, "Segoe UI", Arial, sans-serif;
  transition: background .25s ease, color .25s ease;
}

.tools-page *,
.tools-page *::before,
.tools-page *::after {
  box-sizing: border-box;
}

.tools-page button,
.tools-page input,
.tools-page textarea {
  font: inherit;
}

.tools-page button,
.tools-page a {
  -webkit-tap-highlight-color: transparent;
}

.tools-page a {
  color: inherit;
  text-decoration: none;
}

.ot-light {
  --ot-bg: #f2f5fc;
  --ot-surface: #ffffff;
  --ot-panel: #ffffff;
  --ot-panel-2: #f4f6fc;
  --ot-border: #e1e7f1;
  --ot-text: #17223b;
  --ot-muted: #687894;
  --ot-accent: #4169e9;
  --ot-accent-2: #7957dc;
  --ot-green: #15996b;
  --ot-red: #d83f50;
  background:
    radial-gradient(ellipse at 10% 0%, #e1eaff 0, transparent 35%),
    radial-gradient(ellipse at 95% 35%, #eee8ff 0, transparent 28%),
    var(--ot-bg);
}

.ot-landing,
.ot-app {
  width: min(1440px, 100%);
  margin: 0 auto;
}

.ot-topline,
.ot-app-header,
.ot-header-right,
.ot-brand,
.ot-theme-button,
.ot-hero-actions,
.ot-section-heading,
.ot-card-top,
.ot-card-footer,
.ot-panel-heading,
.ot-toolbar,
.ot-editor-status,
.ot-bottom-note,
.ot-breadcrumb,
.ot-page-heading,
.ot-tool-tabs,
.ot-input-row,
.ot-console-heading,
.ot-sidebar-home,
.ot-nav-group,
.ot-subtool,
.ot-sidebar-bottom {
  display: flex;
  align-items: center;
}

.ot-topline,
.ot-app-header,
.ot-section-heading,
.ot-card-footer,
.ot-panel-heading,
.ot-editor-status,
.ot-console-heading {
  justify-content: space-between;
}

.ot-brand {
  gap: 10px;
  font-size: 19px;
  font-weight: 800;
  letter-spacing: -.5px;
}

.ot-brand svg {
  color: var(--ot-accent);
}

.ot-brand span {
  color: var(--ot-accent);
}

.ot-theme-button {
  gap: 8px;
  border: 1px solid var(--ot-border);
  border-radius: 10px;
  padding: 10px 14px;
  background: var(--ot-panel);
  color: var(--ot-text);
  cursor: pointer;
  font-size: 13px;
  font-weight: 650;
  transition: .2s ease;
}

.ot-theme-button:hover {
  border-color: var(--ot-accent);
  transform: translateY(-1px);
}

.ot-theme-button svg {
  color: var(--ot-accent);
}

.ot-hero {
  position: relative;
  overflow: hidden;
  margin-top: 48px;
  padding: 76px 7%;
  border: 1px solid #ffffff17;
  border-radius: 28px;
  background:
    radial-gradient(circle at 80% 35%, #586dca48, transparent 30%),
    linear-gradient(120deg, #172746, #171a38 65%, #29204a);
  box-shadow: 0 30px 90px #00000025;
}

.ot-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--ot-accent);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.7px;
}

.ot-live-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  border-radius: 50%;
  background: var(--ot-green);
  box-shadow: 0 0 12px #49d7a088;
}

.ot-hero h1 {
  position: relative;
  z-index: 1;
  margin: 20px 0 15px;
  color: #ffffff;
  font-size: clamp(42px, 6vw, 76px);
  line-height: 1.04;
  letter-spacing: -3px;
}

.ot-hero h1 span {
  color: #9aafff;
}

.ot-hero > p {
  position: relative;
  z-index: 1;
  max-width: 570px;
  margin: 0;
  color: #bac7df;
  font-size: 15px;
  line-height: 1.9;
}

.ot-hero-actions {
  position: relative;
  z-index: 1;
  flex-wrap: wrap;
  gap: 22px;
  margin-top: 30px;
}

.ot-main-button {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 13px 19px;
  border-radius: 10px;
  background: #7895ff;
  color: #10182b !important;
  font-size: 13px;
  font-weight: 800;
  transition: .2s ease;
}

.ot-main-button:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 28px #7895ff44;
}

.ot-hero-actions > span {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #c0cbe0;
  font-size: 12px;
}

.ot-hero-actions > span svg {
  color: #66dbad;
}

.ot-hero-orbit {
  position: absolute;
  top: 50%;
  right: 9%;
  display: grid;
  width: 230px;
  height: 230px;
  place-items: center;
  border: 1px solid #a9baff30;
  border-radius: 50%;
  color: #b2c2ff;
  transform: translateY(-50%);
}

.ot-hero-orbit::before,
.ot-hero-orbit::after {
  position: absolute;
  width: 165px;
  height: 165px;
  border: 1px dashed #a9baff42;
  border-radius: 50%;
  content: "";
}

.ot-hero-orbit::after {
  width: 105px;
  height: 105px;
}

.ot-hero-orbit svg {
  position: absolute;
  width: 32px;
  height: 32px;
}

.ot-hero-orbit svg:nth-child(1) {
  top: 22px;
  left: 95px;
}

.ot-hero-orbit svg:nth-child(2) {
  right: 18px;
  bottom: 55px;
}

.ot-hero-orbit svg:nth-child(3) {
  bottom: 25px;
  left: 35px;
}

.ot-section-heading {
  gap: 20px;
  margin: 62px 0 23px;
}

.ot-section-heading h2 {
  margin: 8px 0 0;
  font-size: clamp(22px, 3vw, 29px);
  letter-spacing: -.8px;
}

.ot-count,
.ot-card-number {
  color: var(--ot-muted);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.2px;
}

.ot-category-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 17px;
}

.ot-category-card {
  display: flex;
  min-height: 235px;
  flex-direction: column;
  padding: 23px;
  border: 1px solid var(--ot-border);
  border-radius: 17px;
  background: var(--ot-panel);
  transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
}

.ot-category-card:hover {
  transform: translateY(-6px);
  border-color: var(--ot-accent);
  box-shadow: 0 18px 45px #00000020;
}

.ot-card-top {
  justify-content: space-between;
}

.ot-card-icon,
.ot-page-icon {
  display: grid;
  width: 47px;
  height: 47px;
  place-items: center;
  border: 1px solid #7895ff38;
  border-radius: 13px;
  background: #7895ff14;
  color: var(--ot-accent);
}

.ot-category-card h3 {
  margin: 24px 0 8px;
  font-size: 17px;
}

.ot-category-card > p {
  margin: 0 0 22px;
  color: var(--ot-muted);
  font-size: 12px;
  line-height: 1.7;
}

.ot-card-footer {
  margin-top: auto;
  padding-top: 15px;
  border-top: 1px solid var(--ot-border);
  color: var(--ot-muted);
  font-size: 11px;
}

.ot-card-footer svg {
  color: var(--ot-accent);
}

.ot-landing-footer {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  margin-top: 35px;
  padding: 20px 0 0;
  border-top: 1px solid var(--ot-border);
  color: var(--ot-muted);
  font-size: 11px;
}

.ot-app {
  overflow: hidden;
  border: 1px solid var(--ot-border);
  border-radius: 20px;
  background: var(--ot-surface);
  box-shadow: 0 25px 80px #00000020;
}

.ot-app-header {
  min-height: 70px;
  padding: 0 25px;
  border-bottom: 1px solid var(--ot-border);
  background: var(--ot-surface);
}

.ot-header-right {
  gap: 18px;
}

.ot-local-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--ot-muted);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1px;
}

.ot-mobile-toggle {
  display: none;
  border: 0;
  background: transparent;
  color: var(--ot-text);
  cursor: pointer;
}

.ot-app-body {
  display: grid;
  min-height: 730px;
  grid-template-columns: 245px minmax(0, 1fr);
}

.ot-sidebar {
  display: flex;
  flex-direction: column;
  padding: 24px 15px;
  border-right: 1px solid var(--ot-border);
  background: var(--ot-surface);
}

.ot-sidebar-label {
  padding: 0 10px;
  color: var(--ot-muted);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.ot-sidebar-tools-label {
  margin-top: 30px;
}

.ot-sidebar-home,
.ot-nav-group,
.ot-subtool {
  width: 100%;
  gap: 11px;
  margin-top: 7px;
  padding: 11px 10px;
  border: 1px solid transparent;
  border-radius: 9px;
  background: transparent;
  color: var(--ot-muted);
  text-align: left;
  font-size: 12px;
  cursor: pointer;
  transition: .18s ease;
}

.ot-sidebar-home:hover,
.ot-nav-group:hover,
.ot-subtool:hover {
  background: var(--ot-panel-2);
  color: var(--ot-text);
}

.ot-nav-group.active,
.ot-subtool.active {
  border-color: #7895ff2e;
  background: #7895ff14;
  color: var(--ot-accent);
}

.ot-nav-group span {
  flex: 1;
}

.ot-nav-group > svg:last-child {
  margin-left: auto;
}

.ot-sidebar-divider {
  height: 1px;
  margin: 23px 7px;
  background: var(--ot-border);
}

.ot-subtool {
  padding-left: 14px;
  font-size: 11px;
}

.ot-subtool-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--ot-muted);
}

.ot-subtool.active .ot-subtool-dot {
  background: var(--ot-accent);
  box-shadow: 0 0 9px var(--ot-accent);
}

.ot-sidebar-bottom {
  gap: 10px;
  margin-top: auto;
  padding: 14px 9px;
  border: 1px solid var(--ot-border);
  border-radius: 10px;
  color: var(--ot-green);
  font-size: 11px;
  line-height: 1.5;
}

.ot-sidebar-bottom small {
  color: var(--ot-muted);
  font-size: 9px;
}

.ot-main-panel {
  min-width: 0;
  padding: 28px;
  background: var(--ot-bg);
}

.ot-breadcrumb {
  gap: 9px;
  color: var(--ot-muted);
  font-size: 11px;
}

.ot-breadcrumb a:hover {
  color: var(--ot-accent);
}

.ot-page-heading {
  gap: 15px;
  margin: 25px 0;
}

.ot-page-heading h1 {
  margin: 4px 0;
  font-size: 27px;
  letter-spacing: -.8px;
}

.ot-page-heading p {
  margin: 0;
  color: var(--ot-muted);
  font-size: 12px;
}

.ot-tool-tabs {
  flex-wrap: wrap;
  gap: 7px;
  margin-bottom: 20px;
  padding-bottom: 13px;
  border-bottom: 1px solid var(--ot-border);
}

.ot-tool-tabs button {
  padding: 9px 12px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: var(--ot-muted);
  font-size: 11px;
  cursor: pointer;
  transition: .18s ease;
}

.ot-tool-tabs button:hover,
.ot-tool-tabs button.active {
  border-color: #7895ff38;
  background: #7895ff14;
  color: var(--ot-accent);
}

.ot-message,
.ot-error {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 15px;
  padding: 11px 14px;
  border-radius: 9px;
  font-size: 12px;
}

.ot-message {
  border: 1px solid #49d7a044;
  background: #49d7a012;
  color: var(--ot-green);
}

.ot-error {
  border: 1px solid #ff737d44;
  background: #ff737d12;
  color: var(--ot-red);
}

.ot-workspace-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
  align-items: stretch;
  gap: 15px;
}

.ot-panel {
  min-width: 0;
  padding: 18px;
  border: 1px solid var(--ot-border);
  border-radius: 13px;
  background: var(--ot-panel);
}

.ot-panel-heading {
  gap: 12px;
  margin-bottom: 16px;
}

.ot-panel-heading h2 {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 6px 0 0;
  font-size: 14px;
}

.ot-panel-heading h2 svg {
  color: var(--ot-accent);
}

.ot-language-tag,
.ot-preview-live {
  padding: 6px 8px;
  border: 1px solid var(--ot-border);
  border-radius: 6px;
  color: var(--ot-muted);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .8px;
}

.ot-preview-live {
  border-color: #49d7a044;
  color: var(--ot-green);
}

.ot-toolbar {
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 12px;
}

.ot-toolbar button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 9px;
  border: 1px solid var(--ot-border);
  border-radius: 7px;
  background: var(--ot-panel-2);
  color: var(--ot-muted);
  font-size: 10px;
  cursor: pointer;
  transition: .18s ease;
}

.ot-toolbar button:hover {
  border-color: var(--ot-accent);
  color: var(--ot-accent);
}

.ot-code-editor {
  display: block;
  width: 100%;
  min-height: 410px;
  resize: vertical;
  padding: 17px;
  border: 1px solid var(--ot-border);
  border-radius: 9px;
  outline: none;
  background: #0b1221;
  color: #d8e3fa;
  font-family: Consolas, "Courier New", monospace;
  font-size: 12px;
  line-height: 1.8;
  tab-size: 2;
}

.ot-code-editor:focus {
  border-color: #7895ff99;
  box-shadow: 0 0 0 3px #7895ff18;
}

.ot-editor-status {
  gap: 10px;
  margin-top: 10px;
  color: var(--ot-muted);
  font-size: 10px;
}

.ot-editor-status > span:first-child {
  display: flex;
  align-items: center;
  gap: 7px;
}

.ot-preview-frame-wrap {
  overflow: hidden;
  min-height: 410px;
  border: 1px solid var(--ot-border);
  border-radius: 9px;
  background: #ffffff;
}

.ot-preview-frame {
  display: block;
  width: 100%;
  height: 410px;
  border: 0;
  background: #ffffff;
}

.ot-console {
  margin-top: 14px;
  padding: 12px;
  border: 1px solid var(--ot-border);
  border-radius: 9px;
  background: #0b1221;
}

.ot-console-heading {
  color: #d8e3fa;
  font-size: 11px;
}

.ot-console-heading span {
  display: flex;
  align-items: center;
  gap: 7px;
}

.ot-console-heading button {
  border: 0;
  background: transparent;
  color: #9aafff;
  font-size: 10px;
  cursor: pointer;
}

.ot-console .ot-muted {
  margin: 12px 0 2px;
  font-size: 10px;
}

.ot-console-line {
  padding: 7px 2px;
  border-top: 1px solid #ffffff12;
  color: #d8e3fa;
  font-family: Consolas, monospace;
  font-size: 11px;
  overflow-wrap: anywhere;
}

.ot-console-line.warn {
  color: #f6ca75;
}

.ot-console-line.error {
  color: #ff858d;
}

.ot-network-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(230px, .8fr);
  gap: 15px;
}

.ot-network-panel {
  padding: 23px;
}

.ot-muted {
  color: var(--ot-muted);
  font-size: 12px;
  line-height: 1.7;
}

.ot-field-label {
  display: block;
  margin: 23px 0 8px;
  color: var(--ot-text);
  font-size: 11px;
  font-weight: 700;
}

.ot-input-row {
  gap: 8px;
}

.ot-input-row input {
  width: 100%;
  min-width: 0;
  padding: 12px 13px;
  border: 1px solid var(--ot-border);
  border-radius: 8px;
  outline: none;
  background: var(--ot-panel-2);
  color: var(--ot-text);
  font-family: Consolas, monospace;
  font-size: 12px;
}

.ot-input-row input:focus {
  border-color: var(--ot-accent);
}

.ot-input-row button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  flex: 0 0 auto;
  padding: 12px 15px;
  border: 0;
  border-radius: 8px;
  background: var(--ot-accent);
  color: #ffffff;
  font-size: 11px;
  font-weight: 750;
  cursor: pointer;
}

.ot-example {
  margin-top: 9px;
  color: var(--ot-muted);
  font-size: 10px;
}

.ot-results-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
  margin-top: 25px;
}

.ot-result {
  min-width: 0;
  padding: 12px;
  border: 1px solid var(--ot-border);
  border-radius: 8px;
  background: var(--ot-panel-2);
}

.ot-result span,
.ot-result strong {
  display: block;
  overflow-wrap: anywhere;
}

.ot-result span {
  margin-bottom: 7px;
  color: var(--ot-muted);
  font-size: 10px;
}

.ot-result strong {
  color: var(--ot-text);
  font-family: Consolas, monospace;
  font-size: 12px;
}

.ot-network-info h3 {
  margin: 12px 0 8px;
  font-size: 17px;
}

.ot-info-line {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  padding: 13px 0;
  border-bottom: 1px solid var(--ot-border);
  color: var(--ot-muted);
  font-size: 10px;
}

.ot-info-line strong {
  color: var(--ot-text);
  text-align: right;
}

.ot-info-tip {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-top: 20px;
  padding: 13px;
  border: 1px solid #49d7a033;
  border-radius: 9px;
  background: #49d7a00c;
  color: var(--ot-green);
  font-size: 10px;
  line-height: 1.6;
}

.ot-info-tip svg {
  flex: 0 0 auto;
}

.ot-bottom-note {
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 18px;
  padding: 13px 15px;
  border: 1px solid var(--ot-border);
  border-radius: 9px;
  color: var(--ot-muted);
  font-size: 10px;
}

.ot-bottom-note > svg {
  color: var(--ot-green);
}

.ot-bottom-note > span:nth-child(2) {
  flex: 1;
}

.ot-offline-label {
  color: var(--ot-green);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .8px;
}

@media (max-width: 1100px) {
  .ot-category-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ot-hero-orbit {
    right: 5%;
    opacity: .55;
  }

  .ot-workspace-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 850px) {
  .tools-page {
    padding: 18px;
  }

  .ot-app-body {
    grid-template-columns: 1fr;
  }

  .ot-sidebar {
    display: none;
    border-right: 0;
    border-bottom: 1px solid var(--ot-border);
  }

  .ot-sidebar.ot-sidebar-open {
    display: flex;
  }

  .ot-mobile-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ot-network-layout {
    grid-template-columns: 1fr;
  }

  .ot-main-panel {
    padding: 22px;
  }
}

@media (max-width: 600px) {
  .tools-page {
    padding: 10px;
  }

  .ot-hero {
    margin-top: 25px;
    padding: 43px 25px;
    border-radius: 19px;
  }

  .ot-hero h1 {
    font-size: 45px;
    letter-spacing: -2px;
  }

  .ot-hero > p {
    font-size: 13px;
  }

  .ot-hero-orbit {
    top: 25px;
    right: -100px;
    width: 190px;
    height: 190px;
    transform: none;
    opacity: .25;
  }

  .ot-section-heading {
    align-items: flex-start;
    flex-direction: column;
    margin-top: 40px;
  }

  .ot-category-grid {
    grid-template-columns: 1fr;
  }

  .ot-category-card {
    min-height: 205px;
  }

  .ot-landing-footer {
    flex-direction: column;
  }

  .ot-app-header {
    min-height: 62px;
    padding: 0 14px;
  }

  .ot-header-right {
    gap: 9px;
  }

  .ot-local-badge {
    display: none;
  }

  .ot-theme-button {
    padding: 8px 10px;
    font-size: 11px;
  }

  .ot-main-panel {
    padding: 17px 12px;
  }

  .ot-page-heading {
    align-items: flex-start;
    margin: 20px 0;
  }

  .ot-page-heading h1 {
    font-size: 22px;
  }

  .ot-tool-tabs {
    flex-wrap: nowrap;
    overflow-x: auto;
    padding-bottom: 12px;
  }

  .ot-tool-tabs button {
    flex: 0 0 auto;
  }

  .ot-panel {
    padding: 13px;
  }

  .ot-code-editor,
  .ot-preview-frame,
  .ot-preview-frame-wrap {
    min-height: 340px;
    height: 340px;
  }

  .ot-results-grid {
    grid-template-columns: 1fr;
  }

  .ot-input-row {
    align-items: stretch;
    flex-direction: column;
  }

  .ot-input-row button {
    width: 100%;
  }

  .ot-bottom-note {
    align-items: flex-start;
  }
}

@media (max-width: 380px) {
  .ot-hero h1 {
    font-size: 38px;
  }

  .ot-brand {
    font-size: 16px;
  }

  .ot-toolbar button {
    font-size: 9px;
  }
}
