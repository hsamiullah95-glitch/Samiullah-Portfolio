
/* =====================================
   SAMIULLAH HAKIMI - CONTACT PAGE
===================================== */

.contact-page {
  --cp-purple: #6658f5;
  --cp-blue: #367eea;
  --cp-cyan: #08b6d5;
  --cp-green: #20c997;
  --cp-dark: #11152f;
  --cp-muted: #747c96;

  width: 100%;
  overflow: hidden;
  color: var(--cp-dark);
  background: #f5f7ff;
  font-family: inherit;
}

.contact-page * {
  box-sizing: border-box;
}

/* =====================================
   HERO
===================================== */

.contact-hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding: 85px 7% 75px;
  color: #fff;
  background:
    radial-gradient(circle at 80% 15%, rgba(8,182,213,.19), transparent 30%),
    radial-gradient(circle at 15% 85%, rgba(102,88,245,.3), transparent 35%),
    linear-gradient(125deg, #10152e, #202753 55%, #173b60);
}

.contact-hero-inner {
  position: relative;
  z-index: 2;
  max-width: 1300px;
  min-height: 410px;
  margin: auto;
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  gap: 70px;
  align-items: center;
}

.hero-bg-circle {
  position: absolute;
  z-index: -1;
  border-radius: 50%;
  filter: blur(4px);
  pointer-events: none;
}

.circle-one {
  top: -120px;
  right: 15%;
  width: 300px;
  height: 300px;
  border: 1px solid rgba(255,255,255,.1);
  background: rgba(102,88,245,.08);
}

.circle-two {
  right: -100px;
  bottom: -150px;
  width: 370px;
  height: 370px;
  background: rgba(8,182,213,.1);
}

.circle-three {
  left: 40%;
  bottom: 10%;
  width: 110px;
  height: 110px;
  background: rgba(255,255,255,.035);
}

/* HERO LEFT */

.contact-hero-content {
  max-width: 650px;
}

.contact-label {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 11px 17px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 50px;
  background: rgba(255,255,255,.08);
  color: #b9eaff;
  font-size: 11px;
  font-weight: 850;
  letter-spacing: 2px;
}

.label-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #20d6a9;
  box-shadow: 0 0 13px #20d6a9;
}

.contact-hero-content h1 {
  margin: 25px 0 20px;
  font-size: clamp(43px, 5.7vw, 70px);
  line-height: 1.1;
  font-weight: 900;
  letter-spacing: -2.5px;
}

.contact-hero-content h1 span {
  display: block;
  background: linear-gradient(90deg, #51dcff, #a69aff, #f1a8ff);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.contact-hero-content > p {
  max-width: 560px;
  color: #c5cce4;
  font-size: 15px;
  line-height: 1.95;
}

.hero-buttons {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 13px;
  margin-top: 28px;
}

.hero-primary-btn,
.hero-secondary-btn {
  min-height: 49px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 11px;
  padding: 13px 21px;
  border-radius: 11px;
  text-decoration: none;
  font-size: 13px;
  font-weight: 800;
  transition: .3s ease;
}

.hero-primary-btn {
  background: linear-gradient(110deg, #6558f5, #08b6d5);
  color: #fff;
}

.hero-secondary-btn {
  border: 1px solid rgba(255,255,255,.2);
  background: rgba(255,255,255,.07);
  color: #fff;
}

.hero-primary-btn:hover,
.hero-secondary-btn:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 25px rgba(0,0,0,.18);
}

.hero-mini-info {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  margin-top: 35px;
  color: #b6c3dc;
  font-size: 11px;
}

.hero-mini-info span {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.online-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #20d6a9;
  box-shadow: 0 0 10px #20d6a9;
}

/* HERO RIGHT CONTACT CARDS */

.contact-hero-right {
  width: 100%;
  max-width: 460px;
  justify-self: end;
  padding: 29px;
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 25px;
  background: rgba(255,255,255,.075);
  backdrop-filter: blur(17px);
  box-shadow: 0 20px 60px rgba(0,0,0,.16);
}

.hero-contact-heading {
  margin-bottom: 23px;
}

.hero-contact-heading > span {
  color: #78e5ff;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 2px;
}

.hero-contact-heading h2 {
  margin: 9px 0;
  color: #fff;
  font-size: 24px;
  font-weight: 850;
}

.hero-contact-heading p {
  margin: 0;
  color: #c1cbe2;
  font-size: 12px;
}

.hero-contact-card {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
  margin-top: 14px;
  padding: 19px 16px;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 15px;
  background: rgba(255,255,255,.075);
  color: #fff;
  text-decoration: none;
  transition: .3s ease;
}

.hero-contact-card:hover {
  transform: translateY(-4px);
  border-color: #7be2ff;
  background: rgba(255,255,255,.15);
  box-shadow: 0 12px 25px rgba(0,0,0,.13);
}

.hero-contact-icon {
  width: 51px;
  height: 51px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: linear-gradient(135deg, #6558f5, #9a8cff);
  color: white;
}

.hero-phone .hero-contact-icon {
  background: linear-gradient(135deg, #08b6d5, #20c997);
}

.hero-contact-text {
  min-width: 0;
  flex: 1;
}

.hero-contact-text span {
  color: #a9eaff;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 1.6px;
}

.hero-contact-text h3 {
  margin: 7px 0 0;
  color: #fff;
  font-size: 13px;
  font-weight: 750;
  overflow-wrap: anywhere;
}

.hero-contact-arrow {
  flex-shrink: 0;
  color: #9cecff;
  transition: .3s;
}

.hero-contact-card:hover .hero-contact-arrow {
  transform: translate(3px, -3px);
}

.hero-contact-note {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 20px;
  padding: 15px;
  border-radius: 13px;
  background: rgba(8,182,213,.1);
}

.note-icon {
  width: 39px;
  height: 39px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 12px;
  color: #a5edff;
  background: rgba(8,182,213,.19);
}

.hero-contact-note h4 {
  margin: 0 0 5px;
  color: #fff;
  font-size: 12px;
}

.hero-contact-note p {
  margin: 0;
  color: #c2d4e8;
  font-size: 11px;
}

.hero-bottom-line {
  max-width: 1300px;
  margin: 55px auto 0;
  padding-top: 19px;
  display: flex;
  justify-content: space-between;
  gap: 15px;
  border-top: 1px solid rgba(255,255,255,.13);
  color: #a9b6d1;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 2px;
}

/* =====================================
   MAIN CONTACT SECTION
===================================== */

.contact-main {
  max-width: 1280px;
  margin: auto;
  padding: 95px 30px 100px;
}

.contact-heading {
  max-width: 690px;
  margin: 0 auto 55px;
  text-align: center;
}

.section-tag {
  display: inline-block;
  padding: 8px 14px;
  border-radius: 7px;
  background: #efedff;
  color: #6558f5;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 2px;
}

.contact-heading h2 {
  margin: 16px 0;
  color: #151a35;
  font-size: clamp(30px, 4vw, 43px);
  font-weight: 900;
  letter-spacing: -1px;
}

.contact-heading h2 span {
  color: #6558f5;
}

.contact-heading p {
  color: #747c96;
  font-size: 14px;
  line-height: 1.9;
}

.contact-grid {
  display: grid;
  grid-template-columns: .88fr 1.12fr;
  gap: 28px;
  align-items: stretch;
}

/* INFORMATION CARDS */

.contact-info-column {
  display: flex;
  flex-direction: column;
  gap: 17px;
}

.contact-info-card {
  display: flex;
  align-items: center;
  gap: 17px;
  min-height: 120px;
  padding: 22px;
  border: 1px solid #e9eafa;
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 8px 28px rgba(34,45,100,.045);
  transition: .3s ease;
}

.contact-info-card:hover {
  transform: translateY(-5px);
  border-color: #c9c5ff;
  box-shadow: 0 15px 35px rgba(65,73,150,.1);
}

.info-icon {
  width: 55px;
  height: 55px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 15px;
  color: white;
}

.email-info .info-icon {
  background: linear-gradient(140deg, #6558f5, #a08fff);
}

.phone-info .info-icon {
  background: linear-gradient(140deg, #08b6d5, #45d9c1);
}

.location-info .info-icon {
  background: linear-gradient(140deg, #ff9a62, #ffbf72);
}

.info-content {
  min-width: 0;
  flex: 1;
}

.info-content > span {
  color: #8c93a9;
  font-size: 11px;
  font-weight: 750;
}

.info-content h3 {
  margin: 5px 0;
  color: #202641;
  font-size: 15px;
  font-weight: 850;
}

.info-content a {
  color: #6558f5;
  font-size: 12px;
  font-weight: 750;
  text-decoration: none;
  overflow-wrap: anywhere;
}

.info-content p {
  margin: 5px 0 0;
  color: #7e859c;
  font-size: 12px;
  line-height: 1.6;
}

.info-arrow {
  flex-shrink: 0;
  color: #6558f5;
}

.location-globe {
  flex-shrink: 0;
  color: #ffad6e;
}

.contact-working-card {
  display: flex;
  align-items: flex-start;
  gap: 15px;
  padding: 23px;
  border-radius: 18px;
  color: white;
  background: linear-gradient(120deg, #6558f5, #3f76dc 60%, #08b6d5);
  box-shadow: 0 12px 28px rgba(101,88,245,.18);
}

.working-icon {
  width: 43px;
  height: 43px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: rgba(255,255,255,.17);
}

.contact-working-card h3 {
  margin: 0 0 8px;
  font-size: 16px;
}

.contact-working-card p {
  margin: 0;
  color: #e3eaff;
  font-size: 12px;
  line-height: 1.8;
}

/* =====================================
   CONTACT FORM
===================================== */

.contact-form-card {
  padding: 35px;
  border: 1px solid #e8eafa;
  border-radius: 23px;
  background: #fff;
  box-shadow: 0 12px 45px rgba(34,45,100,.065);
}

.form-heading h2 {
  margin: 16px 0 8px;
  color: #171c38;
  font-size: 27px;
  font-weight: 900;
}

.form-heading p {
  margin: 0 0 28px;
  color: #858ba2;
  font-size: 13px;
  line-height: 1.7;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 17px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 9px;
  margin-bottom: 19px;
}

.form-group label {
  color: #343b58;
  font-size: 12px;
  font-weight: 800;
}

.form-group input,
.form-group textarea {
  width: 100%;
  padding: 15px 16px;
  border: 1px solid #e4e7f2;
  border-radius: 11px;
  outline: none;
  background: #f9faff;
  color: #202641;
  font-family: inherit;
  font-size: 13px;
  transition: .25s ease;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: #a5abc0;
}

.form-group input:focus,
.form-group textarea:focus {
  border-color: #8175ff;
  background: #fff;
  box-shadow: 0 0 0 4px rgba(101,88,245,.09);
}

.form-group textarea {
  min-height: 145px;
  resize: vertical;
}

.contact-submit-btn {
  width: 100%;
  min-height: 53px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  border: none;
  border-radius: 12px;
  background: linear-gradient(105deg, #6558f5, #08b6d5);
  color: white;
  font-family: inherit;
  font-size: 13px;
  font-weight: 850;
  cursor: pointer;
  transition: .3s ease;
}

.contact-submit-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 25px rgba(101,88,245,.23);
}

.form-success {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 15px 0 0;
  color: #159c70;
  font-size: 12px;
  line-height: 1.6;
}

.form-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin: 17px 0 0;
  color: #969cb0;
  font-size: 11px;
}

/* =====================================
   BOTTOM CTA
===================================== */

.contact-bottom {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  max-width: 1220px;
  margin: 0 auto 90px;
  padding: 43px 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  border-radius: 23px;
  color: #fff;
  background:
    radial-gradient(circle at 90% 0%, rgba(255,255,255,.17), transparent 30%),
    linear-gradient(115deg, #171d43, #4642a3 55%, #087eaa);
  box-shadow: 0 18px 40px rgba(38,48,112,.17);
}

.bottom-decoration {
  position: absolute;
  z-index: -1;
  top: -80px;
  right: 25%;
  width: 200px;
  height: 200px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 50%;
}

.bottom-content > span {
  color: #aeeeff;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 2px;
}

.bottom-content h2 {
  margin: 12px 0;
  font-size: clamp(23px, 3vw, 33px);
  font-weight: 900;
}

.bottom-content p {
  margin: 0;
  color: #d5d9f0;
  font-size: 13px;
  line-height: 1.8;
}

.contact-bottom > a {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 15px 22px;
  border-radius: 11px;
  background: #fff;
  color: #5148d5;
  font-size: 13px;
  font-weight: 850;
  text-decoration: none;
  transition: .3s;
}

.contact-bottom > a:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 25px rgba(0,0,0,.15);
}

/* =====================================
   RESPONSIVE DESIGN
===================================== */

@media (max-width: 1000px) {
  .contact-hero-inner {
    gap: 35px;
    grid-template-columns: 1fr .95fr;
  }

  .contact-hero {
    padding-right: 5%;
    padding-left: 5%;
  }

  .contact-hero-right {
    padding: 21px;
  }

  .contact-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 760px) {
  .contact-hero-inner {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .contact-hero-content {
    max-width: 650px;
  }

  .contact-hero-right {
    max-width: 100%;
    justify-self: stretch;
  }

  .contact-grid {
    grid-template-columns: 1fr;
  }

  .contact-bottom {
    margin-right: 22px;
    margin-left: 22px;
  }
}

@media (max-width: 600px) {
  .contact-hero {
    padding: 65px 20px 45px;
  }

  .contact-hero-content h1 {
    font-size: 45px;
    letter-spacing: -1.7px;
  }

  .contact-hero-content > p {
    font-size: 13px;
  }

  .hero-buttons {
    align-items: stretch;
  }

  .hero-primary-btn,
  .hero-secondary-btn {
    flex: 1;
    padding: 12px;
    font-size: 11px;
  }

  .hero-mini-info {
    gap: 12px;
    font-size: 9px;
  }

  .contact-hero-right {
    padding: 19px;
  }

  .hero-contact-heading h2 {
    font-size: 21px;
  }

  .hero-contact-card {
    gap: 11px;
    padding: 15px 12px;
  }

  .hero-contact-icon {
    width: 45px;
    height: 45px;
  }

  .hero-contact-text h3 {
    font-size: 11px;
  }

  .hero-bottom-line {
    margin-top: 35px;
    font-size: 7px;
    letter-spacing: 1px;
  }

  .contact-main {
    padding: 65px 16px 70px;
  }

  .contact-heading {
    margin-bottom: 35px;
  }

  .contact-heading h2 {
    font-size: 30px;
  }

  .contact-info-card {
    gap: 12px;
    padding: 17px;
  }

  .info-icon {
    width: 47px;
    height: 47px;
  }

  .info-content h3 {
    font-size: 13px;
  }

  .info-content a {
    font-size: 10px;
  }

  .contact-form-card {
    padding: 23px 17px;
  }

  .form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .form-heading h2 {
    font-size: 23px;
  }

  .contact-bottom {
    margin: 0 16px 55px;
    padding: 30px 22px;
    align-items: flex-start;
    flex-direction: column;
  }

  .contact-bottom > a {
    width: 100%;
    justify-content: center;
  }
}
