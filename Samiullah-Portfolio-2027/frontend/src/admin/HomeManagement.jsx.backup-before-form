function parseResponse(text) {
  let result = JSON.parse(text);
  if (typeof result === "string") result = JSON.parse(result);
  return result;
}

export default function HomeManagement() {
  const [content, setContent] = useState(DEFAULT_CONTENT);
  const [jsonText, setJsonText] = useState(
    JSON.stringify(DEFAULT_CONTENT, null, 2)
  );
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [uploading, setUploading] = useState(false);
  const [message, setMessage] = useState("");
  const [error, setError] = useState("");

  useEffect(() => {
    let active = true;

    async function loadContent() {
      try {
        const response = await fetch(API, { credentials: "include" });
        const text = await response.text();
        const result = parseResponse(text);

        if (!response.ok || !result.success) {
          throw new Error(result.message || "Could not load Home Page content.");
        }

        const loaded = {
          ...DEFAULT_CONTENT,
          ...(result.data || {})
        };

        if (active) {
          setContent(loaded);
          setJsonText(JSON.stringify(loaded, null, 2));
        }
      } catch (err) {
        if (active) {
          setError("د Home معلومات لوستل نه شول. د API اتصال وګوره. " + err.message);
        }
      } finally {
        if (active) setLoading(false);
      }
    }

    loadContent();
    return () => { active = false; };
  }, []);

  function updateEditor(value) {
    setJsonText(value);
    setMessage("");
    setError("");
  }

  async function saveContent() {
    setSaving(true);
    setMessage("");
    setError("");

    try {
      const parsed = JSON.parse(jsonText);

      if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
        throw new Error("اصلي JSON باید یو Object وي.");
      }

      const response = await fetch(API, {
        method: "PUT",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(parsed)
      });

      const text = await response.text();
      const result = parseResponse(text);

      if (!response.ok || !result.success) {
        throw new Error(result.message || "Save failed.");
      }

      setContent(parsed);
      setJsonText(JSON.stringify(parsed, null, 2));
      setMessage("د Home Page معلومات په بریالیتوب خوندي شول.");
    } catch (err) {
      setError(
        err instanceof SyntaxError
          ? "JSON کې تېروتنه شته. کوډ او کامې (,) وګوره."
          : err.message
      );
    } finally {
      setSaving(false);
    }
  }

  async function uploadImage(event) {
    const file = event.target.files?.[0];
    if (!file) return;

    setUploading(true);
    setMessage("");
    setError("");

    try {
      const formData = new FormData();
      formData.append("image", file);

      const response = await fetch(API, {
        method: "POST",
        credentials: "include",
        body: formData
      });

      const text = await response.text();
      const result = parseResponse(text);

      if (!response.ok || !result.success) {
        throw new Error(result.message || "Image upload failed.");
      }

      const parsed = JSON.parse(jsonText);
      parsed.profile = {
        ...(parsed.profile || {}),
        image: result.data.image
      };

      setContent(parsed);
      setJsonText(JSON.stringify(parsed, null, 2));
      setMessage("عکس پورته شو. اوس د عکس د لینک د خوندي کولو لپاره Save Changes ووهه.");
    } catch (err) {
      setError(err.message);
    } finally {
      setUploading(false);
      event.target.value = "";
    }
  }

  function resetEditor() {
    setJsonText(JSON.stringify(content, null, 2));
    setError("");
    setMessage("Editor بېرته وروستي خوندي شوي معلوماتو ته راوګرځېد.");
  }

  return (
    <div className="sh-content home-management">
      <div className="sh-page-heading">
        <div>
          <span className="sh-section-label">WEBSITE MANAGEMENT</span>
          <h2>Home Page Management</h2>
          <p>د خپل Website د Home Page معلومات، عکسونه او مهارتونه اداره کړه.</p>
        </div>
      </div>

      <div className="home-management-card">
        <div className="home-management-card-heading">
          <div className="home-management-heading-icon">
            <FileJson size={23} />
          </div>
          <div>
            <h3>Home Page Content Editor</h3>
            <p>د Home Page ټول متنونه او معلومات په لاندې JSON کې بدلولای شې.</p>
          </div>
        </div>

        <div className="home-image-upload">
          <div className="home-image-preview">
            {content.profile?.image ? (
              <img src={content.profile.image} alt="Home profile preview" />
            ) : (
              <ImageIcon size={32} />
            )}
          </div>
          <div className="home-image-upload-info">
            <strong>Home Profile Image</strong>
            <p>JPG، PNG یا WEBP؛ تر 5MB پورې.</p>
            <label className="home-upload-button">
              <Upload size={16} />
              {uploading ? "Uploading..." : "Upload New Image"}
              <input
                type="file"
                accept="image/jpeg,image/png,image/webp"
                onChange={uploadImage}
                disabled={uploading}
                hidden
              />
            </label>
          </div>
        </div>

        {message && (
          <div className="home-editor-message success">
            <CheckCircle size={18} />
            {message}
          </div>
        )}

        {error && (
          <div className="home-editor-message error">
            <AlertCircle size={18} />
            {error}
          </div>
        )}

        {loading ? (
          <div className="home-editor-loading">
            <RefreshCw size={20} /> Loading Home Page content...
          </div>
        ) : (
          <>
            <label className="home-json-label" htmlFor="home-json-editor">
              Home Page Data (JSON)
            </label>
            <textarea
              id="home-json-editor"
              className="home-json-editor"
              value={jsonText}
              onChange={(event) => updateEditor(event.target.value)}
              spellCheck={false}
              rows={30}
            />

            <div className="home-json-help">
              <strong>لارښوونه:</strong>
              <span>
                د متنونو د بدلولو پر مهال د JSON نښې، قوسونه او کامې مه حذفوه.
                د بدلونونو وروسته Save Changes ووهه.
              </span>
            </div>

            <div className="home-editor-actions">
              <button
                type="button"
                className="home-save-button"
                onClick={saveContent}
                disabled={saving || uploading}
              >
                <Save size={17} />
                {saving ? "Saving..." : "Save Changes"}
              </button>

              <button
                type="button"
                className="home-reset-button"
                onClick={resetEditor}
                disabled={saving || uploading}
              >
                <RefreshCw size={16} />
                Reset Editor
              </button>
            </div>
          </>
        )}
      </div>
    </div>
  );
}
