import { useEffect, useState } from "react";
import { UserRound, Mail, Phone, BriefcaseBusiness, FileText, Camera, Save } from "lucide-react";
import "./ProfileManagement.css";

const API = "http://localhost:8000/api/profile.php";

export default function ProfileManagement() {
  const [form, setForm] = useState({
    full_name: "",
    title: "",
    bio: "",
    email: "",
    phone: "",
    photo: ""
  });

  const [photoFile, setPhotoFile] = useState(null);
  const [preview, setPreview] = useState("");
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState("");
  const [error, setError] = useState("");

  useEffect(() => {
    let active = true;

    async function loadProfile() {
      try {
        const response = await fetch(API, {
          method: "GET",
          credentials: "include"
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || "Could not load profile.");
        }

        if (active) {
          const data = result.data || {};
          setForm({
            full_name: data.full_name || "",
            title: data.title || "",
            bio: data.bio || "",
            email: data.email || "",
            phone: data.phone || "",
            photo: data.photo || ""
          });
          setPreview(data.photo || "");
        }
      } catch (err) {
        if (active) setError(err.message || "Profile loading failed.");
      } finally {
        if (active) setLoading(false);
      }
    }

    loadProfile();

    return () => {
      active = false;
    };
  }, []);

  function handleChange(event) {
    const { name, value } = event.target;
    setForm((previous) => ({ ...previous, [name]: value }));
  }

  function handlePhoto(event) {
    const file = event.target.files?.[0];
    if (!file) return;

    if (!["image/jpeg", "image/png", "image/webp"].includes(file.type)) {
      setError("Please select a JPG, PNG or WEBP image.");
      event.target.value = "";
      return;
    }

    if (file.size > 5 * 1024 * 1024) {
      setError("Image size must be less than 5 MB.");
      event.target.value = "";
      return;
    }

    setError("");
    setPhotoFile(file);
    setPreview(URL.createObjectURL(file));
  }

  async function handleSubmit(event) {
    event.preventDefault();
    setSaving(true);
    setMessage("");
    setError("");

    try {
      const data = new FormData();
      data.append("full_name", form.full_name);
      data.append("title", form.title);
      data.append("bio", form.bio);
      data.append("email", form.email);
      data.append("phone", form.phone);

      if (photoFile) data.append("photo", photoFile);

      const response = await fetch(API, {
        method: "POST",
        credentials: "include",
        body: data
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message || "Profile could not be saved.");
      }

      setForm((previous) => ({
        ...previous,
        ...(result.data || {})
      }));
      setPreview(result.data?.photo || preview);
      setPhotoFile(null);
      setMessage("Profile updated successfully.");
    } catch (err) {
      setError(err.message || "Something went wrong.");
    } finally {
      setSaving(false);
    }
  }

  if (loading) {
    return <div className="profile-management"><p>Loading profile...</p></div>;
  }

  return (
    <section className="profile-management">
      <div className="profile-management-heading">
        <div>
          <span className="profile-eyebrow">PERSONAL INFORMATION</span>
          <h2>About Me Profile</h2>
          <p>Manage the information displayed on your public About page.</p>
        </div>
        <div className="profile-heading-icon"><UserRound size={25} /></div>
      </div>

      <form className="profile-form" onSubmit={handleSubmit}>
        <div className="profile-photo-panel">
          <div className="profile-photo-preview">
            {preview ? (
              <img src={preview} alt="Profile preview" />
            ) : (
              <UserRound size={48} />
            )}
          </div>
          <div className="profile-photo-info">
            <h3>Profile Photo</h3>
            <p>Choose a JPG, PNG or WEBP image. Maximum size: 5 MB.</p>
            <label className="profile-upload-button">
              <Camera size={17} />
              Choose Photo
              <input type="file" accept="image/jpeg,image/png,image/webp" onChange={handlePhoto} />
            </label>
          </div>
        </div>

        <div className="profile-fields-grid">
          <label className="profile-field">
            <span><UserRound size={16} /> Full Name *</span>
            <input name="full_name" value={form.full_name} onChange={handleChange} placeholder="Enter your full name" required />
          </label>

          <label className="profile-field">
            <span><BriefcaseBusiness size={16} /> Professional Title</span>
            <input name="title" value={form.title} onChange={handleChange} placeholder="e.g. Computer Science Student" />
          </label>

          <label className="profile-field">
            <span><Mail size={16} /> Email Address</span>
            <input type="email" name="email" value={form.email} onChange={handleChange} placeholder="Enter your email" />
          </label>

          <label className="profile-field">
            <span><Phone size={16} /> Phone Number</span>
            <input name="phone" value={form.phone} onChange={handleChange} placeholder="Enter your phone number" />
          </label>

          <label className="profile-field profile-field-full">
            <span><FileText size={16} /> Biography</span>
            <textarea name="bio" value={form.bio} onChange={handleChange} rows={7} placeholder="Write your biography..." />
          </label>
        </div>

        {message && <div className="profile-feedback profile-success">{message}</div>}
        {error && <div className="profile-feedback profile-error">{error}</div>}

        <div className="profile-form-footer">
          <span>Changes will appear on the public About page.</span>
          <button type="submit" disabled={saving}>
            <Save size={18} />
            {saving ? "Saving..." : "Save Profile"}
          </button>
        </div>
      </form>
    </section>
  );
}
