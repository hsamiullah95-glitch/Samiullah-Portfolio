/* =====================================
   SERVICES MANAGEMENT
===================================== */

function ServicesManagement() {
  const [services, setServices] = useState([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");
  const [showForm, setShowForm] = useState(false);
  const [editingId, setEditingId] = useState(null);

  const emptyForm = {
    title: "",
    description: "",
    category: "Web Development",
    icon: "Briefcase",
    is_active: 1
  };

  const [form, setForm] = useState(emptyForm);

  async function loadServices() {
    setLoading(true);
    setError("");

    try {
      const response = await fetch(API, {
        method: "GET",
        credentials: "include",
        headers: { Accept: "application/json" }
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message || "Failed to load services.");
      }

      setServices(Array.isArray(result.data) ? result.data : []);
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadServices();
  }, []);

  function handleAdd() {
    setEditingId(null);
    setForm({ ...emptyForm });
    setError("");
    setShowForm(true);
  }

  function handleEdit(service) {
    setEditingId(service.id);

    setForm({
      title: service.title || "",
      description: service.description || "",
      category: SERVICE_CATEGORIES.includes(service.category)
        ? service.category
        : "Web Development",
      icon: service.icon || "Briefcase",
      is_active: Number(service.is_active)
    });

    setError("");
    setShowForm(true);
  }

  async function handleSubmit(e) {
    e.preventDefault();
    setSaving(true);
    setError("");

    try {
      const response = await fetch(API, {
        method: editingId ? "PUT" : "POST",
        credentials: "include",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json"
        },
        body: JSON.stringify({
          ...form,
          id: editingId
        })
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message || "Could not save service.");
      }

      setShowForm(false);
      setEditingId(null);
      setForm({ ...emptyForm });

      await loadServices();
    } catch (err) {
      setError(err.message);
    } finally {
      setSaving(false);
    }
  }

  async function handleDelete(id) {
    const confirmed = window.confirm(
      "Are you sure you want to delete this service?"
    );

    if (!confirmed) return;

    setError("");

    try {
      const response = await fetch(API, {
        method: "DELETE",
        credentials: "include",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json"
        },
        body: JSON.stringify({ id })
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message || "Could not delete service.");
      }

      await loadServices();
    } catch (err) {
      setError(err.message);
    }
  }

  const activeCount = services.filter(
    service => Number(service.is_active) === 1
  ).length;

  const inactiveCount = services.length - activeCount;

  return (
    <div className="sh-content">
      <section className="sh-services-page">

        <div className="sh-services-heading">
          <div>
            <span className="sh-welcome-tag">
              <Briefcase size={14} />
              SERVICES CONTROL
            </span>

            <h1>Services Management</h1>
            <p>Manage your professional services from here.</p>
          </div>

          <div className="sh-services-heading-actions">
            <button
              className="sh-service-refresh"
              onClick={loadServices}
              title="Refresh"
              type="button"
            >
              <RefreshCw size={18} />
            </button>

            <button
              className="sh-service-add"
              onClick={handleAdd}
              type="button"
            >
              <Plus size={19} />
              Add New Service
            </button>
          </div>
        </div>

        <div className="sh-service-summary">
          <div className="sh-service-summary-card">
            <span>Total Services</span>
            <strong>{services.length}</strong>
            <Briefcase size={25} />
          </div>

          <div className="sh-service-summary-card">
            <span>Active Services</span>
            <strong>{activeCount}</strong>
            <ShieldCheck size={25} />
          </div>

          <div className="sh-service-summary-card">
            <span>Inactive Services</span>
            <strong>{inactiveCount}</strong>
            <Activity size={25} />
          </div>
        </div>

        {error && (
          <div className="sh-service-error">{error}</div>
        )}

        {showForm && (
          <form
            className="sh-service-form"
            onSubmit={handleSubmit}
          >
            <div className="sh-service-form-heading">
              <div>
                <h2>
                  {editingId ? "Edit Service" : "Add New Service"}
                </h2>
                <p>Enter your service information below.</p>
              </div>

              <button
                type="button"
                className="sh-service-close"
                onClick={() => setShowForm(false)}
              >
                <X size={20} />
              </button>
            </div>

            <div className="sh-service-input-grid">

              <div className="sh-service-field">
                <label>Service Title</label>
                <input
                  type="text"
                  placeholder="Example: Web Development"
                  value={form.title}
                  onChange={e =>
                    setForm({ ...form, title: e.target.value })
                  }
                  required
                />
              </div>

              <div className="sh-service-field">
                <label>Service Category</label>
                <select
                  value={form.category}
                  onChange={e =>
                    setForm({ ...form, category: e.target.value })
                  }
                  required
                >
                  {SERVICE_CATEGORIES.map(category => (
                    <option key={category} value={category}>
                      {category}
                    </option>
                  ))}
                </select>
              </div>

              <div className="sh-service-field">
                <label>Icon Name</label>
                <input
                  type="text"
                  placeholder="Example: Code, Briefcase"
                  value={form.icon}
                  onChange={e =>
                    setForm({ ...form, icon: e.target.value })
                  }
                />
              </div>

              <div className="sh-service-field">
                <label>Service Status</label>
                <select
                  value={form.is_active}
                  onChange={e =>
                    setForm({
                      ...form,
                      is_active: Number(e.target.value)
                    })
                  }
                >
                  <option value={1}>Active</option>
                  <option value={0}>Inactive</option>
                </select>
              </div>

              <div className="sh-service-field sh-service-full">
                <label>Description</label>
                <textarea
                  rows="5"
                  placeholder="Write a description about your service..."
                  value={form.description}
                  onChange={e =>
                    setForm({ ...form, description: e.target.value })
                  }
                  required
                />
              </div>

            </div>

            <div className="sh-service-form-buttons">
              <button
                type="submit"
                disabled={saving}
                className="sh-service-save"
              >
                {saving
                  ? "Saving..."
                  : editingId
                    ? "Update Service"
                    : "Save Service"}
              </button>

              <button
                type="button"
                className="sh-service-cancel"
                onClick={() => setShowForm(false)}
              >
                Cancel
              </button>
            </div>
          </form>
        )}

        <div className="sh-services-list">

          <div className="sh-services-list-heading">
            <div>
              <h2>All Services</h2>
              <p>View and manage all your services.</p>
            </div>

            <span>{services.length} Services</span>
          </div>

          {loading ? (
            <div className="sh-services-empty">
              <RefreshCw size={30} />
              <h3>Loading Services...</h3>
              <p>Please wait a moment.</p>
            </div>
          ) : services.length === 0 ? (
            <div className="sh-services-empty">
              <Briefcase size={42} />
              <h3>No Services Found</h3>
              <p>You have not added any services yet.</p>

              <button onClick={handleAdd} type="button">
                <Plus size={17} />
                Add Your First Service
              </button>
            </div>
          ) : (
            <div className="sh-services-table-wrap">
              <table className="sh-services-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Service Title</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Icon</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>

                <tbody>
                  {services.map((service, index) => (
                    <tr key={service.id}>
                      <td>{index + 1}</td>

                      <td>
                        <strong>{service.title}</strong>
                      </td>

                      <td>
                        <span className="sh-service-category">
                          {service.category || "Uncategorized"}
                        </span>
                      </td>

                      <td className="sh-service-description">
                        {service.description}
                      </td>

                      <td>{service.icon}</td>

                      <td>
                        <span
                          className={
                            Number(service.is_active) === 1
                              ? "sh-service-active"
                              : "sh-service-inactive"
                          }
                        >
                          {Number(service.is_active) === 1
                            ? "Active"
                            : "Inactive"}
                        </span>
                      </td>

                      <td>
                        <div className="sh-service-actions">
                          <button
                            className="sh-service-edit"
                            onClick={() => handleEdit(service)}
                            title="Edit"
                            type="button"
                          >
                            <Pencil size={16} />
                          </button>

                          <button
                            className="sh-service-delete"
                            onClick={() => handleDelete(service.id)}
                            title="Delete"
                            type="button"
                          >
                            <Trash2 size={16} />
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </section>
    </div>
  );
}

